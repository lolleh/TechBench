# HybridBench OS - PREEMPT_RT Kernel Configuration
# Based on Linux 6.x with real-time patches

# General setup
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_NO_HZ_FULL=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ_1000_RAW=y

# Processor type and features
CONFIG_SMP=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_MCE=y
CONFIG_X86_EXTENDED_PLATFORM=y

# Memory options
CONFIG_FLATMEM=y
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_KSM=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_RUNTIME=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# USB support (critical for device detection)
