CONFIG_GPIO_PCF857X=y

# I2C support (critical for PMIC communication)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SMBUS=y
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_I801=y
CONFIG_I2C_ISCH=y
CONFIG_I2C_NFORCE2=y
CONFIG_I2C_PIIX4=y
