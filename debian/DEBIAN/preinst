#!/bin/bash
set -e

# Verify system meets minimum requirements
echo "Checking HybridBench installation requirements..."

# Check Python
if ! command -v python3 &> /dev/null; then
    echo "ERROR: python3 is required but not installed."
    echo "Install with: sudo apt install python3 python3-venv"
    exit 1
fi

PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
echo "[OK] Python $PYTHON_VERSION"

# Check Node.js
if ! command -v node &> /dev/null; then
    echo "WARNING: nodejs is recommended for the web interface."
    echo "Install with: sudo apt install nodejs npm"
fi

# Check USB subsystem
if [ -d /sys/bus/usb ]; then
    echo "[OK] USB subsystem available"
else
    echo "WARNING: USB subsystem not detected"
fi

# Check user groups
if groups | grep -q plugdev; then
    echo "[OK] User is in plugdev group"
else
    echo "NOTE: Add yourself to plugdev for USB access:"
    echo "  sudo usermod -aG plugdev \$USER"
fi

# Check container runtime
if command -v podman &> /dev/null; then
    echo "[OK] Podman available"
elif command -v docker &> /dev/null; then
    echo "[OK] Docker available"
else
    echo "NOTE: No container runtime found. Install podman or docker."
fi

echo ""
echo "Pre-installation check complete."
