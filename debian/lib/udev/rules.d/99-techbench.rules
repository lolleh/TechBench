# HybridBench USB Device Rules
# Grants access to plugdev group for common repair/diagnostic devices

# Bus Pirate
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6001", GROUP="plugdev", MODE="0664"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6010", GROUP="plugdev", MODE="0664"

# FT232R USB-UART Bridge
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6001", GROUP="plugdev", MODE="0664"

# CP210x USB-UART Bridge
SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", GROUP="plugdev", MODE="0664"
SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea70", GROUP="plugdev", MODE="0664"

# CH340/CH341 USB-Serial
