{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "TechBench",
  "version": "0.1.0",
  "identifier": "dev.techbench.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "TechBench - Electronics & Mobile Repair Platform",
    "windows": [
      {
        "title": "TechBench",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128@2x.png"
      },
      "wix": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0",
          "python3"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "adb",
          "cmd": "adb",
          "args": true
        },
        {
          "name": "fastboot",
          "cmd": "fastboot",
          "args": true
        },
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "sigrok-cli",
          "cmd": "sigrok-cli",
          "args": true
        }
      ]
    }
  }
}
